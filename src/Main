public class Main {

    // Delivery interface
    interface IDeliveryMethod {
        void calculateCost();
        void trackDelivery();
    }

    // Payment interface
    interface IPaymentMethod {
        void processPayment();
        void confirmPayment();
    }

    // ---------------- DELIVERY CLASSES ----------------

    static class CourierDelivery implements IDeliveryMethod {

        public void calculateCost() {
            System.out.println("Курьерлік жеткізу бағасы есептелді");
        }

        public void trackDelivery() {
            System.out.println("Курьердің орналасуы көрсетілді");
        }
    }

    static class PickupDelivery implements IDeliveryMethod {

        public void calculateCost() {
            System.out.println("Самовывоз бағасы есептелді");
        }

        public void trackDelivery() {
            System.out.println("Тапсырыс дайын");
        }
    }

    static class PostalDelivery implements IDeliveryMethod {

        public void calculateCost() {
            System.out.println("Пошта жеткізу бағасы есептелді");
        }

        public void trackDelivery() {
            System.out.println("Пошта статусы көрсетілді");
        }
    }

    // ---------------- PAYMENT CLASSES ----------------

    static class CardPayment implements IPaymentMethod {

        public void processPayment() {
            System.out.println("Картамен төлем жасалды");
        }

        public void confirmPayment() {
            System.out.println("Төлем расталды");
        }
    }

    static class CashPayment implements IPaymentMethod {

        public void processPayment() {
            System.out.println("Қолма-қол төлем қабылданды");
        }

        public void confirmPayment() {
            System.out.println("Төлем жеткізу кезінде расталады");
        }
    }

    static class OnlinePayment implements IPaymentMethod {

        public void processPayment() {
            System.out.println("Онлайн төлем орындалды");
        }

        public void confirmPayment() {
            System.out.println("Онлайн төлем расталды");
        }
    }

    // ---------------- ABSTRACT FACTORY ----------------

    interface OrderFactory {
        IDeliveryMethod createDelivery();
        IPaymentMethod createPayment();
    }

    // Courier + Card
    static class CourierCardFactory implements OrderFactory {

        public IDeliveryMethod createDelivery() {
            return new CourierDelivery();
        }

        public IPaymentMethod createPayment() {
            return new CardPayment();
        }
    }

    // Pickup + Cash
    static class PickupCashFactory implements OrderFactory {

        public IDeliveryMethod createDelivery() {
            return new PickupDelivery();
        }

        public IPaymentMethod createPayment() {
            return new CashPayment();
        }
    }

    // Postal + Online
    static class PostalOnlineFactory implements OrderFactory {

        public IDeliveryMethod createDelivery() {
            return new PostalDelivery();
        }

        public IPaymentMethod createPayment() {
            return new OnlinePayment();
        }
    }

    // ---------------- MAIN METHOD ----------------

    public static void main(String[] args) {

        // Factory таңдау
        OrderFactory factory = new CourierCardFactory();

        // Delivery және Payment объектілерін құру
        IDeliveryMethod delivery = factory.createDelivery();
        IPaymentMethod payment = factory.createPayment();

        // Delivery methods
        delivery.calculateCost();
        delivery.trackDelivery();

        // Payment methods
        payment.processPayment();
        payment.confirmPayment();
    }
}
